local espObjects = {}
local function clearESP(other)
	local objects = espObjects[other]
	if not objects then return end
	if objects.highlight then objects.highlight:Destroy() end
	if objects.tag then objects.tag:Destroy() end
	espObjects[other] = nil
end
local function updateESP()
	local _, _, ownRoot = characterParts()
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			local character = other.Character
			local head = character and character:FindFirstChild("Head")
			local root = character and character:FindFirstChild("HumanoidRootPart")
			local distance = ownRoot and root and (ownRoot.Position - root.Position).Magnitude or math.huge
			local target = inList("Targets List", other)
			local friend = inList("Friends List", other)
			local visible = character and head and distance <= (controls.sliders["ESP Distance"] or 1000)
				and (controls.toggles.ESP or (target and controls.toggles["Target ESP"])
					or (friend and controls.toggles["Friend ESP"]))
			if visible then
				local objects = espObjects[other]
				if not objects or objects.head ~= head then
					clearESP(other)
					local highlight = Instance.new("Highlight")
					highlight.Name = "ARG_EspHighlight"
					highlight.Adornee = character
					highlight.FillTransparency = 0.78
					highlight.OutlineTransparency = 0
					highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
					highlight.Parent = character
					local tag = Instance.new("BillboardGui")
					tag.Name = "ARG_EspTag"
					tag.Adornee = head
					tag.AlwaysOnTop = true
					tag.StudsOffset = Vector3.new(0, 2.5, 0)
					tag.Size = UDim2.fromOffset(160, 32)
					tag.Parent = gui
					local text = label(tag, "", 0, 0, 160, 32, 12, C.white, true,
						Enum.TextXAlignment.Center)
					objects = {highlight = highlight, tag = tag, text = text, head = head}
					espObjects[other] = objects
				end
				objects.highlight.FillColor = target and Color3.fromRGB(255, 75, 75)
					or friend and Color3.fromRGB(80, 255, 170) or C.blue
				objects.highlight.OutlineColor = objects.highlight.FillColor
				local humanoid = character:FindFirstChildOfClass("Humanoid")
				local details = other.DisplayName
				if controls.toggles["Health Display"] and humanoid then
					details ..= "  " .. tostring(math.floor(humanoid.Health)) .. " HP"
				end
				if controls.toggles["Distance Display"] then
					details ..= "  " .. tostring(math.floor(distance)) .. "m"
				end
				objects.text.Text = details
				objects.tag.Size = UDim2.fromOffset(math.floor(160 * (controls.sliders["ESP Size"] or 1.2)), 32)
			else
				clearESP(other)
			end
		end
	end
end
task.spawn(function()
	while gui.Parent do
		updateESP()
		task.wait(0.25)
	end
end)

-- A game module can assign a real server-authorized attack function here.
-- All filtering, range, priority, and speed settings are already gathered.
local GameAdapter = { Attack = nil }
local function scanTargets()
	local _, _, root = characterParts()
	if not root then return {} end
	local result = {}
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player and not inList("Whitelist", other)
			and not inList("Protect List", other) and not inList("Friends List", other)
			and (not controls.toggles["Target-Only Mode"] or inList("Targets List", other))
			and (not controls.toggles["Same-Team Protection"] or player.Team == nil
				or other.Team ~= player.Team) then
			local character = other.Character
			local otherRoot = character and character:FindFirstChild("HumanoidRootPart")
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if otherRoot and humanoid and humanoid.Health > 0 then
				local distance = (root.Position - otherRoot.Position).Magnitude
				local scanRange = controls.sliders["Target Scan Range"] or 500
				local attackRange = controls.sliders["Adjustable Range"] or 350
				if controls.toggles["Server-Wide Targeting"]
					or (distance <= scanRange
						and (controls.toggles["Remote Strike"] or distance <= attackRange)) then
					table.insert(result, {player = other, distance = distance})
				end
			end
		end
	end
	if controls.toggles["Priority Targeting"] then
		table.sort(result, function(a, b) return a.distance < b.distance end)
	end
	return result
end
task.spawn(function()
	local attackedOnce = false
	while gui.Parent do
		if controls.toggles["Omega Aura"] and GameAdapter.Attack then
			if controls.toggles["Continuous Attack"] or not attackedOnce then
				local candidates = scanTargets()
				local limit = controls.toggles["Multi-Target Mode"]
					and (controls.sliders["Max Targets"] or 5) or 1
				for index = 1, math.min(#candidates, limit) do
					pcall(GameAdapter.Attack, candidates[index].player, controls)
				end
				attackedOnce = true
			end
		else
			attackedOnce = false
		end
		task.wait(math.max(0.1, 1 / (controls.sliders["Attack Speed"] or 1.2)))
	end
end)
local gameSpecific = {"Omega Aura", "Server-Wide Targeting", "Remote Strike",
	"Multi-Target Mode", "Continuous Attack", "Auto Re-Target", "Target-Only Mode",
	"Priority Targeting", "Repeat After Respawn", "Anti-Grab", "Anti-Carry Lock",
