	local id = toastId
	toastText.Text = message
	toast.Visible = true
	task.delay(controls.sliders["Notification Time"] or 3, function()
		if id == toastId and toast.Parent then toast.Visible = false end
	end)
end
local function previewAction(name)
	if actionHandlers[name] then
		local okay, err = pcall(actionHandlers[name])
		if not okay then notify(name .. " failed: " .. tostring(err)) end
	else
		notify(name .. " needs the target game's API")
	end
end

