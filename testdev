end
GameAdapter.Attack = function(candidates, limit)
	if controls.toggles["Screen Click Combat"] then
		GameAdapter.Mode = "ScreenClickInput"
		if #candidates == 0 then GameAdapter.click.pauseReason = "No eligible nearby target"; return false end
		for _, candidate in ipairs(candidates) do
			if GameAdapter.CallClick(candidate) then
				return true, candidate.player, candidate.player.Character
			end
		end
		return false
	end
	local remote = GameAdapter.AuraRemote()
	if not remote or #candidates == 0 then return false end
	GameAdapter.Mode = GameAdapter.learnedRemote == remote and "ObservedUnarmedPunch" or "CombatServiceHit"
	limit = math.min(#candidates, math.clamp(math.floor(limit), 1, 100))
	-- One aggregate rate applies to all targets. Rotate eligible targets across cycles.
	local start = controls.toggles["Multi-Target Mode"] and (GameAdapter.roundRobin % limit + 1) or 1
	for offset = 0, limit - 1 do
		local index = (start + offset - 1) % limit + 1
		local candidate = candidates[index]
		if GameAdapter.CallAura(remote, candidate) then
			GameAdapter.roundRobin = index
			return true, candidate.player, candidate.player.Character
		end
	end
	return false
end
