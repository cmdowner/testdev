local function detailCard(parent, title, glyph, x, y, width, toggles, sliders, actionsList, lists)
	local countToggles = #(toggles or {})
	local countSliders = #(sliders or {})
	local countLists = #(lists or {})
	local countActions = #(actionsList or {})
	local height = 49 + countToggles * 34 + countSliders * 49
		+ countLists * 66 + (countActions > 0 and 56 or 0)
	local holder = card(parent, x, y, width, height, title, glyph)
	local pos = 37
	for _, name in ipairs(toggles or {}) do
		toggle(holder, name, 15, pos, width - 30, false)
		pos += 34
	end
	for _, spec in ipairs(sliders or {}) do
		slider(holder, spec, 15, pos, width - 30, false)
		pos += 49
	end
	for _, name in ipairs(lists or {}) do
		local field = frame(holder, 14, pos + 1, width - 28, 58, C.panel3)
		round(field, 4)
		stroke(field, C.line)
		label(field, name, 10, 4, 235, 17, 11, C.platinum, true)
		local count = label(field, "0 SAVED", width - 133, 4, 88, 17,
			9, C.bright, true, Enum.TextXAlignment.Right)
		local input = make("TextBox", field, {
			Position = UDim2.fromOffset(10, 27), Size = UDim2.fromOffset(width - 190, 24),
			BackgroundColor3 = C.background, BorderSizePixel = 0,
			Text = "", PlaceholderText = name == "Playlist" and "Audio asset ID"
				or name == "Script List" and "Script URL" or "Username / user ID",
			PlaceholderColor3 = C.muted, TextColor3 = C.platinum, TextSize = 11,
			Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left,
			ClearTextOnFocus = false,
		})
		round(input, 3)
		stroke(input, C.line)
		local entries = listEntries[name]
		count.Text = tostring(#entries) .. " SAVED"
		listCountViews[name] = listCountViews[name] or {}
		table.insert(listCountViews[name], count)
		local function refreshCount()
			for _, view in ipairs(listCountViews[name]) do
				view.Text = tostring(#entries) .. " SAVED"
			end
		end
		local function add()
			local value = input.Text:match("^%s*(.-)%s*$")
			if value == "" then return end
			if #entries >= 50 then notify(name .. " is full") return end
			table.insert(entries, value)
			refreshCount()
			input.Text = ""
			notify("Added to " .. name .. ": " .. value)
		end
		button(field, "+ ADD", width - 170, 26, 63, 25, add)
		button(field, "−", width - 101, 26, 45, 25, function()
			if #entries > 0 then table.remove(entries) end
			refreshCount()
		end)
		input.FocusLost:Connect(function(enterPressed) if enterPressed then add() end end)
		pos += 66
	end
	if countActions > 0 then
		local actionWidth = math.floor((width - 30 - (countActions - 1) * 8) / countActions)
		for i, name in ipairs(actionsList) do
			button(holder, string.upper(name), 15 + (i - 1) * (actionWidth + 8),
				pos + 4, actionWidth, 38, function() previewAction(name) end)
		end
	end
	return height
end

