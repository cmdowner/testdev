local function setToggle(name, value)
	controls.toggles[name] = value
	for _, render in ipairs(controls.toggleViews[name] or {}) do render(value) end
	if hooks.toggles[name] then hooks.toggles[name](value) end
end

local function toggle(parent, name, x, y, width, compact)
	local height = compact and 16 or 32
	local titleSize = compact and 9 or 12
	local trackW = compact and 23 or 38
	local trackH = compact and 12 or 20
	local text = make("TextButton", parent, {
		Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(width - trackW - 9, height),
		BackgroundTransparency = 1, Text = name, TextColor3 = C.platinum,
		TextSize = titleSize, Font = Enum.Font.GothamMedium,
		TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	local track = make("TextButton", parent, {
		Position = UDim2.fromOffset(x + width - trackW, y + math.floor((height - trackH) / 2)),
		Size = UDim2.fromOffset(trackW, trackH), BackgroundColor3 = C.off,
		BorderSizePixel = 0, Text = "", AutoButtonColor = false,
	})
	round(track, trackH)
	local knobSize = trackH - 4
	local knob = frame(track, 2, 2, knobSize, knobSize, C.white)
	round(knob, knobSize)
	controls.toggleViews[name] = controls.toggleViews[name] or {}
	local function render(value)
		local color = value and C.blue or C.off
		local position = UDim2.fromOffset(value and (trackW - knobSize - 2) or 2, 2)
		if animationsEnabled then
			TweenService:Create(track, TweenInfo.new(0.15), {BackgroundColor3 = color}):Play()
			TweenService:Create(knob, TweenInfo.new(0.15), {Position = position}):Play()
		else
			track.BackgroundColor3 = color
			knob.Position = position
		end
		text.TextColor3 = value and C.white or C.platinum
	end
	table.insert(controls.toggleViews[name], render)
	track.Activated:Connect(function() setToggle(name, not controls.toggles[name]) end)
	text.Activated:Connect(function() setToggle(name, not controls.toggles[name]) end)
	render(controls.toggles[name] == true)
	return track
end

local function formatNumber(value, spec)
	if spec.precision == 0 then return tostring(math.floor(value + 0.5)) end
	return string.format("%." .. tostring(spec.precision or 1) .. "f", value)
end

local function setSlider(name, value)
	controls.sliders[name] = value
	for _, render in ipairs(controls.sliderViews[name] or {}) do render(value) end
	if hooks.sliders[name] then hooks.sliders[name](value) end
end

local function slider(parent, spec, x, y, width, compact)
	local name = spec.name
	if controls.sliders[name] == nil then controls.sliders[name] = spec.default or spec.min end
	local h = compact and 21 or 47
	local titleSize = compact and 8 or 12
	local barX = compact and math.floor(width * 0.49) or 238
	local barW = compact and (width - barX - 29) or (width - barX - 48)
	barW = math.max(28, barW)
	label(parent, name, x, y, barX - 4, h, titleSize, C.platinum)
	local bar = make("TextButton", parent, {
		Position = UDim2.fromOffset(x + barX, y + math.floor(h / 2) - 7),
		Size = UDim2.fromOffset(barW, 14), BackgroundColor3 = C.off,
		BackgroundTransparency = 1,
		BorderSizePixel = 0, Text = "", AutoButtonColor = false,
	})
	local track = frame(bar, 0, 5, barW, 4, C.off)
	round(track, 4)
	local fill = frame(bar, 0, 5, 0, 4, C.bright)
	round(fill, 4)
	local thumb = frame(bar, 0, 1, 12, 12, C.white)
	round(thumb, 12)
	stroke(thumb, C.blue, 2)
	local valueText = label(parent, "", x + barX + barW + 4, y, 45, h,
		compact and 8 or 11, C.bright, true)
	controls.sliderViews[name] = controls.sliderViews[name] or {}
	local function render(value)
		local alpha = math.clamp((value - spec.min) / (spec.max - spec.min), 0, 1)
		fill.Size = UDim2.fromOffset(math.floor(barW * alpha), 4)
		thumb.Position = UDim2.fromOffset(math.floor((barW - 12) * alpha), 1)
		valueText.Text = formatNumber(value, spec)
	end
	table.insert(controls.sliderViews[name], render)
	local dragging = false
	local function update(input)
		local alpha = math.clamp((input.Position.X - bar.AbsolutePosition.X) / math.max(1, bar.AbsoluteSize.X), 0, 1)
		local raw = spec.min + (spec.max - spec.min) * alpha
		local step = spec.step or 0.1
		setSlider(name, math.clamp(math.floor(raw / step + 0.5) * step, spec.min, spec.max))
	end
	bar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			update(input)
		end
	end)
	local changed = UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			update(input)
		end
	end)
	local ended = UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	gui.Destroying:Connect(function() changed:Disconnect(); ended:Disconnect() end)
	render(controls.sliders[name] or spec.default or spec.min)
	return bar
end

local S = function(name, min, max, default, precision, step)
	sliderDefaults[name] = default
	return {name = name, min = min, max = max, default = default,
		precision = precision or 0, step = step or 1}
end

