	RP.Send = function(channel, clock)
		local stream = RP.streams[channel]
		if not RP.alive or not gui.Parent or not stream.dirty or stream.pending or clock < stream.retryAt
			or clock < RP.nextRequest then return false end
		local remote = GameAdapter.Remote(stream.names)
		if not remote then
