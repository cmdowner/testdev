local function inList(name, other)
	local username, userId = other.Name:lower(), tostring(other.UserId)
	local displayName = (other.DisplayName or other.Name):lower()
	local partial = name == "Targets List" or name == "Friends List"
	for _, entry in ipairs(listEntries[name] or {}) do
		if partial then
			for term in tostring(entry):gmatch("[^,]+") do
				term = term:match("^%s*(.-)%s*$"):lower()
				if term ~= "" and (term == username or term == userId or (not tonumber(term)
					and (username:find(term, 1, true) or displayName:find(term, 1, true)))) then return true end
			end
		else
			local term = tostring(entry):match("^%s*(.-)%s*$"):lower()
			if term == username or term == userId then return true end
		end
	end
	return false
end
local friendCache = {}
controls.friendRuntime = {pending = {}, retryAt = {}, checkedAt = {}, inFlight = 0, alive = true}
local function isFriend(other)
	if inList("Friends List", other) then return true, true end
	local cached = friendCache[other.UserId]
	local F, id = controls.friendRuntime, other.UserId
	if cached ~= nil and (cached == true or not F.checkedAt[id] or os.clock() - F.checkedAt[id] < 60) then return cached, true end
	if F.alive and not F.pending[id] and F.inFlight < 2 and os.clock() >= (F.retryAt[id] or 0) then
		F.pending[id] = true; F.inFlight += 1
		task.spawn(function()
			local okay, result = pcall(function() return player:IsFriendsWithAsync(id) end)
			if F.alive and other.Parent == Players then
				if okay and type(result) == "boolean" then
					friendCache[id] = result; F.checkedAt[id] = os.clock(); controls.scanRevision += 1
				else F.retryAt[id] = os.clock() + 15 end
			end
			F.pending[id] = nil; F.inFlight -= 1
		end)
	end
	-- Unknown friendship is protected until the asynchronous check finishes.
	return true, false
end
