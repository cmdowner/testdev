local function refreshGhost()
	local character = player.Character
	if not character then return end
	local enabled = controls.toggles["Ghost Mode"] == true
	local alpha = (controls.sliders["Ghost Transparency"] or 45) / 100
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") then
			if enabled then
				if originalTransparency[part] == nil then
					originalTransparency[part] = part.LocalTransparencyModifier
				end
				part.LocalTransparencyModifier = alpha
			elseif originalTransparency[part] ~= nil then
				part.LocalTransparencyModifier = originalTransparency[part]
				originalTransparency[part] = nil
			end
		end
	end
end
