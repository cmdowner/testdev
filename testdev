local function make(className, parent, props)
	local object = Instance.new(className)
	for key, value in pairs(props or {}) do
		object[key] = value
	end
	object.Parent = parent
	return object
end

local function frame(parent, x, y, w, h, color, transparency)
	return make("Frame", parent, {
		Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h),
		BackgroundColor3 = color or C.panel, BackgroundTransparency = transparency or 0,
		BorderSizePixel = 0,
	})
end

local function round(object, radius)
	make("UICorner", object, { CornerRadius = UDim.new(0, radius or 6) })
	return object
end

local function stroke(object, color, thickness, transparency)
	make("UIStroke", object, {
		Color = color or C.line, Thickness = thickness or 1,
		Transparency = transparency or 0,
	})
	return object
end

local function gradient(object, top, bottom, rotation)
	make("UIGradient", object, {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, top),
			ColorSequenceKeypoint.new(1, bottom),
		}),
		Rotation = rotation or 90,
	})
	return object
end

local function label(parent, content, x, y, w, h, size, color, bold, align)
	return make("TextLabel", parent, {
		Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h),
		BackgroundTransparency = 1, Text = content,
		TextColor3 = color or C.platinum, TextSize = size or 12,
		Font = bold and Enum.Font.GothamBold or Enum.Font.GothamMedium,
		TextXAlignment = align or Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
end

local function button(parent, content, x, y, w, h, onClick)
	local b = make("TextButton", parent, {
		Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h),
		BackgroundColor3 = C.panel2, BorderSizePixel = 0,
		Text = content, TextColor3 = C.platinum, TextSize = 11,
		Font = Enum.Font.GothamBold, AutoButtonColor = false,
	})
	round(b, 5)
	stroke(b, C.line)
	if onClick then b.Activated:Connect(onClick) end
	b.MouseEnter:Connect(function()
		if animationsEnabled then
			TweenService:Create(b, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(11, 47, 78)}):Play()
		else b.BackgroundColor3 = Color3.fromRGB(11, 47, 78) end
	end)
	b.MouseLeave:Connect(function()
		if animationsEnabled then
			TweenService:Create(b, TweenInfo.new(0.12), {BackgroundColor3 = C.panel2}):Play()
		else b.BackgroundColor3 = C.panel2 end
	end)
	return b
end

local function line(parent, x, y, w, color)
	return frame(parent, x, y, w, 1, color or C.line)
end

local function segment(parent, x1, y1, x2, y2, color, thickness)
	local dx, dy = x2 - x1, y2 - y1
	local piece = frame(parent, x1, y1, math.sqrt(dx * dx + dy * dy), thickness or 2,
		color or C.platinum)
	piece.AnchorPoint = Vector2.new(0, 0.5)
	piece.Rotation = math.deg(math.atan2(dy, dx))
	round(piece, thickness or 2)
	return piece
end

local function circle(parent, x, y, size, color, thickness)
	local ring = frame(parent, x, y, size, size, C.background, 1)
	round(ring, size)
	stroke(ring, color or C.platinum, thickness or 2)
	return ring
end

local function icon(parent, kind, x, y, size, tint)
	local group = frame(parent, x, y, size, size, C.background, 1)
	local c = tint or C.platinum
	local k = size / 24
	local function s(a, b, d, e, thickness)
		segment(group, a * k, b * k, d * k, e * k, c, (thickness or 2) * k)
	end
	local function o(a, b, diameter)
		circle(group, a * k, b * k, diameter * k, c, 2 * k)
	end
	if kind == "A" then
		s(2, 21, 12, 2, 3); s(12, 2, 22, 21, 3); s(7, 15, 17, 15, 2.5)
		s(17, 9, 22, 21, 1)
	elseif kind == "Home" then
		s(3, 11, 12, 3); s(12, 3, 21, 11); s(5, 10, 5, 21)
		s(19, 10, 19, 21); s(5, 21, 19, 21); s(10, 21, 10, 15); s(14, 15, 14, 21)
	elseif kind == "Combat" or kind == "Targets" then
		o(5, 5, 14); o(10, 10, 4)
		s(12, 0, 12, 6); s(12, 18, 12, 24)
		s(0, 12, 6, 12); s(18, 12, 24, 12)
	elseif kind == "Movement" then
		o(13, 1, 5); s(11, 8, 6, 13); s(11, 8, 16, 11)
		s(6, 13, 3, 12); s(16, 11, 21, 10); s(11, 8, 12, 15)
		s(12, 15, 19, 22); s(12, 15, 6, 22)
	elseif kind == "Player" then
		o(8, 2, 8); s(5, 22, 5, 18); s(5, 18, 8, 14)
		s(8, 14, 16, 14); s(16, 14, 19, 18); s(19, 18, 19, 22); s(5, 22, 19, 22)
	elseif kind == "Visuals" then
		s(2, 12, 8, 6); s(8, 6, 16, 6); s(16, 6, 22, 12)
		s(2, 12, 8, 18); s(8, 18, 16, 18); s(16, 18, 22, 12); o(9, 9, 6)
	elseif kind == "Whitelists" then
		s(12, 1, 21, 5); s(21, 5, 20, 16); s(20, 16, 12, 23)
		s(12, 23, 4, 16); s(4, 16, 3, 5); s(3, 5, 12, 1)
	elseif kind == "Music" then
		s(10, 5, 20, 3); s(10, 5, 10, 19); s(20, 3, 20, 16)
		o(4, 16, 6); o(14, 13, 6)
	elseif kind == "World" then
		o(2, 2, 20); s(2, 12, 22, 12); s(12, 2, 12, 22)
		s(5, 6, 19, 6, 1); s(5, 18, 19, 18, 1)
	elseif kind == "Scripts" then
		s(8, 5, 2, 12); s(2, 12, 8, 19); s(16, 5, 22, 12)
		s(22, 12, 16, 19); s(14, 3, 10, 21)
	elseif kind == "Settings" then
		o(7, 7, 10)
		for i = 0, 7 do
			local a = i * math.pi / 4
			s(12 + math.cos(a) * 9, 12 + math.sin(a) * 9,
				12 + math.cos(a) * 12, 12 + math.sin(a) * 12)
		end
	elseif kind == "Credits" then
		local points = {}
		for i = 0, 9 do
			local angle = -math.pi / 2 + i * math.pi / 5
			local r = i % 2 == 0 and 11 or 5
			points[i + 1] = {12 + math.cos(angle) * r, 12 + math.sin(angle) * r}
		end
		for i = 1, 10 do
			local a, b = points[i], points[i % 10 + 1]
			s(a[1], a[2], b[1], b[2])
		end
	else
		o(4, 4, 16)
	end
	return group
end

