			if not state then state = {phrase = 1, index = 0, next = clock}; RP.animations.bio = state end
			if clock >= state.next and #lines > 0 then
				state.phrase = (state.phrase - 1) % #lines + 1
				local prefixes = RP.Prefixes(lines[state.phrase])
				state.index += 1
				if state.index > #prefixes then state.index = 1; state.phrase = state.phrase % #lines + 1; prefixes = RP.Prefixes(lines[state.phrase]) end
				RP.fullBio = prefixes[#prefixes] or ""
				RP.Set("bio", prefixes[state.index] or "")
				state.next = clock + (state.index == #prefixes and 0.8 or 1 / math.clamp(controls.sliders["Bio Speed"] or 15, 1, 8))
			end
		elseif controls.toggles["Bio Blinker"] then
			local lines, state = phrases("Blink Phrases"), RP.animations.blink
			if not state then state = {phrase = 1, visible = false, next = clock}; RP.animations.blink = state end
			if clock >= state.next and #lines > 0 then
				state.phrase = (state.phrase - 1) % #lines + 1
				state.visible = not state.visible
				RP.fullBio = lines[state.phrase]
				RP.Set("bio", state.visible and RP.fullBio or "")
				if not state.visible then state.phrase = state.phrase % #lines + 1 end
				state.next = clock + 1 / math.clamp(controls.sliders["Blink Speed"] or 5, 1, 4)
			end
		end
		if controls.toggles["Rainbow Colors"] then
			local state = RP.animations.color
			if not state then state = {step = 0, next = clock}; RP.animations.color = state end
			if clock >= state.next then
				state.step += 1
				local preset = math.clamp(math.floor(controls.sliders["Color Preset"] or 4), 1, 4)
				local color
				if preset == 4 then color = Color3.fromHSV((clock * 0.12) % 1, 1, 1)
				else
					local palettes = {{Color3.fromRGB(255, 0, 0), Color3.fromRGB(0, 0, 255)},
						{Color3.fromRGB(0, 255, 0), Color3.fromRGB(0, 0, 0)},
						{Color3.fromRGB(0, 0, 0), Color3.fromRGB(255, 255, 255)}}
					color = palettes[preset][(state.step - 1) % 2 + 1]
				end
				for _, channel in ipairs({"nameColor", "bioColor"}) do
					if GameAdapter.Remote(names[channel]) then RP.Set(channel, color) end
				end
				state.next = clock + 1 / math.clamp(controls.sliders["Color Speed"] or 4, 1, 4)
			end
		end
		for offset = 1, #order do
			local index = (RP.cursor + offset - 1) % #order + 1
			if RP.Send(order[index], clock) then RP.cursor = index; break end
		end
	end
	local heartbeat = RunService.Heartbeat:Connect(function() RP.Tick(os.clock()) end)
	gui.Destroying:Connect(function()
		RP.alive = false; heartbeat:Disconnect()
		for _, stream in pairs(RP.streams) do
			stream.dirty = false
			if stream.thread and stream.pending and type(task.cancel) == "function" then
				if pcall(task.cancel, stream.thread) then GameAdapter.ownCalls[stream.thread] = nil; stream.pending = false end
			end
			if stream.original ~= nil then GameAdapter.CallRemote(GameAdapter.Remote(stream.names), stream.original) end
		end
	end)
end

