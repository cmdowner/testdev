		if channel == "name" or channel == "bio" then
			local prefixes = RP.Prefixes(value)
			value = prefixes[#prefixes] or ""
		end
		if not force and stream.value == value then return end
		stream.value, stream.dirty = value, true
		stream.touched = true
		stream.version = (stream.version or 0) + 1
	end
	RP.Restore = function(channel, fallback)
		local stream = RP.streams[channel]
		if stream.original == nil and not stream.touched then return end
		stream.dirty = false; stream.version = (stream.version or 0) + 1
