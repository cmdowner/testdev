		local kills = stats and (stats:FindFirstChild("Kills")
			or stats:FindFirstChild("Eliminations") or stats:FindFirstChild("KOs"))
		local count = kills and kills:IsA("ValueBase") and tonumber(kills.Value)
		killCountText.Text = count and (tostring(math.floor(count)) .. " / 500") or "-- / 500"
		local filled = count and math.clamp(math.floor(count / 500 * #progressCells), 0, #progressCells) or 0
		for i, cell in ipairs(progressCells) do
			cell.BackgroundColor3 = i <= filled and C.bright or C.off
		end
		frameCount, frameElapsed, statusTick = 0, 0, 0
	end
	local character, humanoid, root = characterParts()
	if controls.protectionRuntime then
		local okay, err = pcall(controls.protectionRuntime.Update, character, humanoid, root)
		if not okay then controls.protectionRuntime.lastError = tostring(err):sub(1, 160) end
	end
	if not character or not humanoid or not root then return end
	if character ~= trackedCharacter then
		if trackedCharacter and not controls.toggles["Repeat After Respawn"] then
			setToggle("Omega Aura", false)
		end
		clearFly(); restoreCollisions(); controls.RestoreGhost()
		trackedCharacter = character
		baseWalkSpeed, baseJumpPower, baseUseJumpPower =
			(humanoid.WalkSpeed > 0 and humanoid.WalkSpeed or 16), (humanoid.JumpPower > 0 and humanoid.JumpPower or 50), humanoid.UseJumpPower
		controls.baseJumpHeight = humanoid.JumpHeight > 0 and humanoid.JumpHeight or 7.2
		wasSprinting, wasJumpModified = false, false
		lastSafeCFrame = root.CFrame
		originalTransparency = {}
		originalDecalTransparency = {}
	end
	if controls.toggles.Sprint then
		humanoid.WalkSpeed = (controls.sliders["Sprint Speed"] or 1.4) * (baseWalkSpeed or 16)
		wasSprinting = true
	elseif wasSprinting and baseWalkSpeed then
		humanoid.WalkSpeed = baseWalkSpeed
		wasSprinting = false
	end
	if controls.toggles["Jump Power"] then
		humanoid.UseJumpPower = true
		humanoid.JumpPower = controls.sliders["Jump Power Slider"] or 50
		wasJumpModified = true
	elseif wasJumpModified and baseJumpPower then
		humanoid.JumpPower = baseJumpPower
		humanoid.UseJumpPower = baseUseJumpPower
		wasJumpModified = false
	end
	if controls.toggles.TPWalk and humanoid.MoveDirection.Magnitude > 0 then
		root.CFrame += humanoid.MoveDirection * (controls.sliders["TPWalk Speed"] or 1.8) * 20 * dt
	end
	if controls.toggles.Fly then
		if not flyForce or flyForce.Parent ~= root then
			clearFly()
			flyAttachment = Instance.new("Attachment")
			flyAttachment.Name = "ARG_FlyAttachment"
			flyAttachment.Parent = root
			flyForce = Instance.new("LinearVelocity")
			flyForce.Name = "ARG_FlyVelocity"
			flyForce.Attachment0 = flyAttachment
			flyForce.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
			flyForce.RelativeTo = Enum.ActuatorRelativeTo.World
			flyForce.ForceLimitsEnabled = false
			flyForce.Parent = root
		end
		local vertical = (UserInputService:IsKeyDown(Enum.KeyCode.Space) and 1 or 0)
			- (UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) and 1 or 0)
		if os.clock() < flyVerticalUntil then vertical = flyVerticalDirection end
		local speed = (controls.sliders["Fly Speed"] or 2.2) * 25
		flyForce.VectorVelocity = humanoid.MoveDirection * speed + Vector3.new(0, vertical * speed, 0)
	end
	if os.clock() < dashEndAt and not controls.toggles.Fly then
		root.AssemblyLinearVelocity = dashVector
	end
	if controls.toggles["Safe Spot"] then
		if not controls.safeSpot or controls.safeSpot.character ~= character then
			controls.safeSpot = {character = character, cframe = root.CFrame}
		end
		local source = controls.safeSpot.cframe.Position
		root.CFrame = CFrame.new(source.X, 150, source.Z)
		root.AssemblyLinearVelocity = Vector3.zero
		lastSafeCFrame = root.CFrame
	end

	if controls.toggles["Ghost Mode"] then refreshGhost() end
	if controls.toggles["Anti-Fling"] and not controls.toggles.Fly and os.clock() >= dashEndAt and (root.AssemblyLinearVelocity.Magnitude > 150
		or root.AssemblyAngularVelocity.Magnitude > 18) then
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		recordProtectionEvent("High velocity detected; local movement stabilized")
	end
	local blockForcedMove = controls.toggles["Anti-Bring"]
		or controls.toggles["Anti-Repeat-Bring"] or controls.toggles["Anti-Forced-TP"]
	if blockForcedMove and lastSafeCFrame and not controls.toggles["Safe Spot"]
		and not controls.toggles.TPWalk
		and not controls.toggles.Fly and os.clock() >= dashEndAt
		and (root.Position - lastSafeCFrame.Position).Magnitude > math.max(35, dt * 180) then
		root.CFrame = lastSafeCFrame
		root.AssemblyLinearVelocity = Vector3.zero
		recordProtectionEvent("Large position change detected; local position restored")
	else
		lastSafeCFrame = root.CFrame
	end
	local recoveryArmed = controls.toggles["Movement Recovery"] or controls.toggles["Restore Movement"]
		or controls.toggles["Restore Jump"] or controls.toggles["Anti-Grab"]
		or controls.toggles["Anti-Carry Lock"] or controls.toggles["Break Carry"]
		or controls.toggles["Break Hold"] or controls.toggles["Anti-Repeat Carry"]
		or controls.toggles["Stop Ceiling Hold"] or controls.toggles["Stop Wall Pin"]
	if recoveryArmed then
		if humanoid.PlatformStand or humanoid.Sit or root.Anchored
			or (humanoid.WalkSpeed <= 0 and not controls.toggles.Fly) then
			recordProtectionEvent("Movement hold detected; trying local recovery")
		end
		if not controls.toggles.Fly then humanoid.PlatformStand = false end
		if humanoid.Sit then humanoid.Sit = false end
		if root.Anchored then root.Anchored = false end
		if (controls.toggles["Movement Recovery"] or controls.toggles["Restore Movement"]
			or controls.toggles["Anti-Grab"] or controls.toggles["Anti-Carry Lock"])
			and humanoid.WalkSpeed <= 0 and baseWalkSpeed then
			humanoid.WalkSpeed = baseWalkSpeed
		end
		if controls.toggles["Restore Jump"] and not controls.toggles["Jump Power"] then
			if humanoid.UseJumpPower then
				if humanoid.JumpPower <= 0 then humanoid.JumpPower = baseJumpPower or 50 end
			elseif humanoid.JumpHeight <= 0 then humanoid.JumpHeight = controls.baseJumpHeight or 7.2 end
		end
	end
	if protectionStatusView then
		local armed = recoveryArmed or blockForcedMove or controls.toggles["Anti-Fling"]
			or controls.toggles["Anti Ragdoll"]
		protectionStatusView.Text = armed and (os.clock() - lastProtectionEventAt < 5
			and protectionEventText or "LOCAL PROTECTION READY")
			or "LOCAL PROTECTION: OFF"
	end
end)
