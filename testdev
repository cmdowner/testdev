	if not GameAdapter.remoteIndex or clock - (GameAdapter.remoteIndexAt or -math.huge) >= 3 then
		local index = {}
		for _, remote in ipairs(storage:GetDescendants()) do
			if remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction") then
				local name = remote.Name:lower()
				if index[name] == nil then index[name] = remote else index[name] = false end
			end
		end
		GameAdapter.remoteIndex, GameAdapter.remoteIndexAt = index, clock
	end
	for _, name in ipairs(names) do
		local remote = GameAdapter.remoteIndex[name:lower()]
		if remote and remote.Parent then
			GameAdapter.remoteCache[key] = {remote = remote, checked = clock}; return remote
		end
	end
