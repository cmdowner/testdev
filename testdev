local statusTick = 0
local heartbeat = RunService.Heartbeat:Connect(function(dt)
	frameCount += 1
	frameElapsed += dt
	statusTick += dt
	if statusTick >= 1 then
		local elapsed = math.floor(os.clock() - startTime)
		sessionStatus.Text = string.format("SESSION  %02d:%02d", math.floor(elapsed / 60), elapsed % 60)
		fpsStatus.Text = "FPS  " .. tostring(math.floor(frameCount / math.max(0.01, frameElapsed)))
		local active = 0
		for name, enabled in pairs(controls.toggles) do
			if enabled and name ~= "UI Animations" and not table.find(gameSpecific, name) then
				active += 1
			end
		end
		moduleStatus.Text = "ACTIVE MODULES " .. tostring(active)
		frameCount, frameElapsed, statusTick = 0, 0, 0
	end
	local character, humanoid, root = characterParts()
	if not character or not humanoid or not root then return end
	if character ~= trackedCharacter then
		if trackedCharacter and not controls.toggles["Repeat After Respawn"] then
			setToggle("Omega Aura", false)
		end
		clearFly(); restoreCollisions()
		trackedCharacter = character
		baseWalkSpeed, baseJumpPower, baseUseJumpPower =
			humanoid.WalkSpeed, humanoid.JumpPower, humanoid.UseJumpPower
		wasSprinting, wasJumpModified = false, false
		lastSafeCFrame = root.CFrame
		originalTransparency = {}
	end
	if controls.toggles.Sprint then
		humanoid.WalkSpeed = (controls.sliders["Sprint Speed"] or 1.4) * (baseWalkSpeed or 16)
		wasSprinting = true
	elseif wasSprinting and baseWalkSpeed then
		humanoid.WalkSpeed = baseWalkSpeed
		wasSprinting = false
	end
	if controls.toggles["Jump Power"] then
		humanoid.UseJumpPower = true
		humanoid.JumpPower = controls.sliders["Jump Power Slider"] or 50
		wasJumpModified = true
	elseif wasJumpModified and baseJumpPower then
		humanoid.JumpPower = baseJumpPower
		humanoid.UseJumpPower = baseUseJumpPower
		wasJumpModified = false
	end
	if controls.toggles.TPWalk and humanoid.MoveDirection.Magnitude > 0 then
		root.CFrame += humanoid.MoveDirection * (controls.sliders["TPWalk Speed"] or 1.8) * 20 * dt
	end
	if controls.toggles.Fly then
		if not flyForce or flyForce.Parent ~= root then
			clearFly()
			flyAttachment = Instance.new("Attachment")
			flyAttachment.Name = "ARG_FlyAttachment"
			flyAttachment.Parent = root
			flyForce = Instance.new("LinearVelocity")
			flyForce.Name = "ARG_FlyVelocity"
			flyForce.Attachment0 = flyAttachment
			flyForce.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
			flyForce.RelativeTo = Enum.ActuatorRelativeTo.World
			flyForce.ForceLimitsEnabled = false
			flyForce.Parent = root
		end
		local vertical = (UserInputService:IsKeyDown(Enum.KeyCode.Space) and 1 or 0)
			- (UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) and 1 or 0)
		if os.clock() < flyVerticalUntil then vertical = flyVerticalDirection end
		local speed = (controls.sliders["Fly Speed"] or 2.2) * 25
		flyForce.VectorVelocity = humanoid.MoveDirection * speed + Vector3.new(0, vertical * speed, 0)
	end
	if os.clock() < dashEndAt and not controls.toggles.Fly then
		root.AssemblyLinearVelocity = dashVector
	end
	if controls.toggles.NoClip then
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				if originalCollisions[part] == nil then originalCollisions[part] = part.CanCollide end
				part.CanCollide = false
			end
		end
	end
	if controls.toggles["Ghost Mode"] then refreshGhost() end
	if controls.toggles["Anti-Fling"] and root.AssemblyLinearVelocity.Magnitude > 150 then
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end
	local blockForcedMove = controls.toggles["Anti-Bring"]
		or controls.toggles["Anti-Repeat-Bring"] or controls.toggles["Anti-Forced-TP"]
	if blockForcedMove and lastSafeCFrame and not controls.toggles.TPWalk
		and not controls.toggles.Fly and os.clock() >= dashEndAt
		and (root.Position - lastSafeCFrame.Position).Magnitude > math.max(35, dt * 180) then
		root.CFrame = lastSafeCFrame
		root.AssemblyLinearVelocity = Vector3.zero
	else
		lastSafeCFrame = root.CFrame
	end
	if controls.toggles["Movement Recovery"] or controls.toggles["Restore Movement"]
		or controls.toggles["Restore Jump"] or controls.toggles["Anti-Grab"]
		or controls.toggles["Anti-Carry Lock"] or controls.toggles["Break Carry"]
		or controls.toggles["Break Hold"] or controls.toggles["Anti-Repeat Carry"] then
		if not controls.toggles.Fly then humanoid.PlatformStand = false end
		if humanoid.Sit then humanoid.Sit = false end
		if root.Anchored then root.Anchored = false end
		if controls.toggles["Restore Jump"] then
			humanoid.UseJumpPower = true
			humanoid.JumpPower = baseJumpPower or 50
		end
	end
end)
local function doDash()
	if not controls.toggles.Dash then notify("Enable Dash first") return end
	local _, _, root = characterParts()
	if root then
		local speed = (controls.sliders["Dash Speed"] or 1.5) * 65
		dashVector = root.CFrame.LookVector * speed + Vector3.new(0, 6, 0)
		dashEndAt = os.clock() + (controls.sliders["Dash Distance"] or 60) / speed
		root.AssemblyLinearVelocity = dashVector
	end
end
actionHandlers["Dash Now"] = doDash
actionHandlers["Fly Up"] = function()
	flyVerticalDirection, flyVerticalUntil = 1, os.clock() + 0.7
end
actionHandlers["Fly Down"] = function()
	flyVerticalDirection, flyVerticalUntil = -1, os.clock() + 0.7
end
local dashInput = UserInputService.InputBegan:Connect(function(input, consumed)
	if consumed or input.KeyCode ~= Enum.KeyCode.Q or not controls.toggles.Dash then return end
	doDash()
end)
gui.Destroying:Connect(function()
	heartbeat:Disconnect(); dashInput:Disconnect()
	clearFly(); restoreCollisions()
	for other in pairs(espObjects) do clearESP(other) end
	local _, humanoid = characterParts()
	if humanoid then
		if wasSprinting and baseWalkSpeed then humanoid.WalkSpeed = baseWalkSpeed end
		if wasJumpModified and baseJumpPower then
			humanoid.JumpPower = baseJumpPower
			humanoid.UseJumpPower = baseUseJumpPower
		end
	end
	for part, original in pairs(originalTransparency) do
		if part.Parent then part.LocalTransparencyModifier = original end
	end
	localSound:Destroy()
	Lighting.Brightness = originalLighting.Brightness
	Lighting.ClockTime = originalLighting.ClockTime
	Lighting.FogEnd = originalLighting.FogEnd
	Lighting.Ambient = originalLighting.Ambient
	Lighting.OutdoorAmbient = originalLighting.OutdoorAmbient
	if createdAtmosphere then createdAtmosphere:Destroy()
	elseif atmosphere and originalAtmosphereDensity then
		atmosphere.Density = originalAtmosphereDensity
	end
	if clouds and originalCloudCover then clouds.Cover = originalCloudCover end
end)

local cameraConnection
local function fitToScreen()
	local camera = workspace.CurrentCamera
	if not camera then return end
	local viewport = camera.ViewportSize
	local scale = math.min(1, (viewport.X - 16) / 1260, (viewport.Y - 16) / 684)
	canvasScale.Scale = math.max(0.25, scale)
	canvas.Position = UDim2.fromOffset(
		math.floor((viewport.X - 1260 * canvasScale.Scale) / 2),
		math.floor((viewport.Y - 684 * canvasScale.Scale) / 2)
	)
end
local function watchCamera()
	if cameraConnection then cameraConnection:Disconnect() end
	local camera = workspace.CurrentCamera
	if camera then
		cameraConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(fitToScreen)
	end
	fitToScreen()
end
local currentCameraConnection = workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera)
watchCamera()
gui.Destroying:Connect(function()
	if cameraConnection then cameraConnection:Disconnect() end
	currentCameraConnection:Disconnect()
end)

-- Drag the top bar; the A icon remains attached to the same canvas.
local dragging = false
local dragStart, canvasStart
header.Active = true
header.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		canvasStart = canvas.Position
	end
end)
local dragChanged = UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		canvas.Position = UDim2.fromOffset(canvasStart.X.Offset + delta.X,
			canvasStart.Y.Offset + delta.Y)
	end
end)
local dragEnded = UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)
gui.Destroying:Connect(function() dragChanged:Disconnect(); dragEnded:Disconnect() end)

