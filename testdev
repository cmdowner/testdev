GameAdapter.ClickAPI = function()
	local env = executorGlobal()
	local click = type(mouse1click) == "function" and mouse1click or env.mouse1click
	local press = type(mouse1press) == "function" and mouse1press or env.mouse1press
	local release = type(mouse1release) == "function" and mouse1release or env.mouse1release
	if type(click) == "function" then return "mouse1click", click end
	if type(press) == "function" and type(release) == "function" then
