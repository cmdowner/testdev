controls.LimitText = function(value, maxBytes)
	value = tostring(value or "")
	local okay, length = pcall(utf8.len, value)
	if not okay or length == nil then return "" end
	if #value <= maxBytes then return value end
	return value:sub(1, utf8.offset(value, 0, maxBytes + 1) - 1)
end
