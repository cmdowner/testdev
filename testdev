GameAdapter.ReleaseClick = function(force)
	local state = GameAdapter.click
	if not state.held then return true end
	if not force and os.clock() < (state.releaseAt or 0) then return false end
	local okay, result = pcall(state.release)
	if okay and result ~= false then
		state.held, state.release = false, nil
		if state.pressAccepted then state.completed += 1 end
		state.pressAccepted = nil
		return true
	end
	state.failed += 1
	state.lastError = "Click release failed: " .. tostring(result):sub(1, 120)
	state.pauseReason = state.lastError
	state.releaseAt = os.clock() + 0.5
	return false -- Keep the held latch: no new presses until a release succeeds.
end
GameAdapter.ClickInputReady = function()
	local state = GameAdapter.click
	if not state.alive or not gui.Parent then return false, "UI closed" end
	if main.Visible then return false, "Close the ARG menu" end
	local env = executorGlobal()
	local active = type(isrbxactive) == "function" and isrbxactive or env.isrbxactive
	if type(active) ~= "function" then
		active = type(iswindowactive) == "function" and iswindowactive or env.iswindowactive
	end
	if type(active) == "function" then
		local okay, value = pcall(active)
		if not okay or value ~= true then return false, "Roblox window not focused" end
	elseif not state.focusKnown or not state.focused then
		return false, "Click inside Roblox to establish focus"
	end
	local okay, focused = pcall(function() return UserInputService:GetFocusedTextBox() end)
	if not okay or focused ~= nil then return false, "Text input focused or unavailable" end
	local menuOkay, menuOpen = pcall(function() return game:GetService("GuiService").MenuIsOpen end)
	if not menuOkay or menuOpen then return false, "Roblox menu open or unavailable" end
	local downOkay, down = pcall(function()
		return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
	end)
	if not downOkay or (down and not state.held) then return false, "Manual mouse press active" end
	local positionOkay, position = pcall(function() return UserInputService:GetMouseLocation() end)
	if not positionOkay or not position then return false, "Mouse position unavailable" end
	local p, size = open.AbsolutePosition, open.AbsoluteSize
	if open.Visible and position.X >= p.X and position.X <= p.X + size.X
		and position.Y >= p.Y and position.Y <= p.Y + size.Y then
