-- A single scheduler owns RP text/color updates. Pending RemoteFunctions keep
-- only the latest requested value, and every text prefix ends on a UTF-8 boundary.
do
	local RP = {streams = {}, animations = {}, sent = 0, completed = 0, failed = 0,
		nextRequest = -math.huge, lastTick = -math.huge, cursor = 0, alive = true}
	controls.rpRuntime = RP
	local order = {"name", "bio", "nameColor", "bioColor"}
	local names = {name = {"UpdateRPName", "SetName"}, bio = {"UpdateBio", "SetBio"},
		nameColor = {"UpdateRPColor", "SetNameColor"}, bioColor = {"UpdateBioColor", "SetBioColor"}}
	local labelNames = {name = {rpname = true, rpnametext = true}, bio = {bio = true, biotext = true, rpbio = true}}
	for _, channel in ipairs(order) do RP.streams[channel] = {names = names[channel], retryAt = 0} end
	RP.Prefixes = function(value, maxCharacters)
		value = controls.LimitText(value, 500)
		local starts, prefixes = {}, {}
		for position in utf8.codes(value) do table.insert(starts, position) end
		for i = 1, math.min(#starts, maxCharacters or 80) do
			prefixes[i] = value:sub(1, (starts[i + 1] or #value + 1) - 1)
		end
		return prefixes
	end
	RP.Snapshot = function()
		local character = player.Character
		for channel, attribute in pairs({name = "RPName", bio = "Bio", nameColor = "RPColor", bioColor = "BioColor"}) do
			local stream = RP.streams[channel]
			if stream.original == nil then
				for _, object in ipairs({player, character}) do
					if object then
						local okay, value = pcall(function() return object:GetAttribute(attribute) end)
						if okay and ((channel == "name" or channel == "bio") and type(value) == "string"
							or (channel == "nameColor" or channel == "bioColor") and typeof(value) == "Color3") then
							stream.original = value; break
						end
					end
				end
			end
		end
		if character then
			for _, object in ipairs(controls.CharacterItems(character).all) do
				if object:IsA("TextLabel") then
					for channel, accepted in pairs(labelNames) do
						if accepted[object.Name:lower()] then
							local stream, color = RP.streams[channel], RP.streams[channel .. "Color"]
							if stream.original == nil then stream.original = object.Text end
							if color.original == nil then color.original = object.TextColor3 end
						end
