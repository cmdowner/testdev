	local objectsOkay, objects = pcall(function()
		return player:FindFirstChildOfClass("PlayerGui"):GetGuiObjectsAtPosition(position.X, position.Y)
	end)
	if not objectsOkay then return false, "Game UI hit testing unavailable" end
	for _, object in ipairs(objects) do
		if object:IsA("GuiButton") or object:IsA("TextBox")
			or object:IsA("ScrollingFrame") or object.Active then
			return false, "Cursor over game UI"
