	local root = character and character:FindFirstChild("HumanoidRootPart")
	local ownCharacter = player.Character
	local ownRoot = ownCharacter and ownCharacter:FindFirstChild("HumanoidRootPart")
	local ownHumanoid = ownCharacter and ownCharacter:FindFirstChildOfClass("Humanoid")
	local clock = os.clock()
	if not gui.Parent or not controls.toggles["Omega Aura"] or not remote or not remote.Parent
		or not ownRoot or not ownHumanoid or ownHumanoid.Health <= 0 or not root or not humanoid or humanoid.Health <= 0
		or GameAdapter.FightingState() == false or GameAdapter.auraPending[humanoid]
		or GameAdapter.auraInFlight >= GameAdapter.maxInFlight
		or clock < GameAdapter.nextDispatch or clock < GameAdapter.retryAt
		or GameAdapter.OldestRequest() >= GameAdapter.requestTimeout then return false end
	if not GameAdapter.TargetAllowed(other) or not GameAdapter.InRange((ownRoot.Position - root.Position).Magnitude) then return false end
	local epoch, token = GameAdapter.auraEpoch, {started = clock, humanoid = humanoid}
	GameAdapter.auraPending[humanoid] = token; GameAdapter.jobs[token] = token
	GameAdapter.auraInFlight += 1
	GameAdapter.nextDispatch = clock + GameAdapter.Interval()
	token.thread = task.spawn(function()
		local thread = coroutine.running() or GameAdapter
		local okay, err = pcall(function()
			if not gui.Parent or not controls.toggles["Omega Aura"] or epoch ~= GameAdapter.auraEpoch
				or player.Character ~= ownCharacter or other.Character ~= character or not remote.Parent
				or humanoid.Parent ~= character or root.Parent ~= character or ownRoot.Parent ~= ownCharacter
				or humanoid.Health <= 0 or ownHumanoid.Health <= 0 or GameAdapter.FightingState() == false then return end
			if not GameAdapter.TargetAllowed(other) or not GameAdapter.InRange((ownRoot.Position - root.Position).Magnitude) then return end
			local args = GameAdapter.BuildAuraArguments(other, humanoid, root, ownRoot)
			if not args then GameAdapter.lastCombatError = "Punch schema changed; click Learn Punch"; return end
			GameAdapter.ownCalls[thread] = true; GameAdapter.auraSent += 1
			local reply
			if remote:IsA("RemoteEvent") then remote:FireServer(table.unpack(args, 1, args.n))
			else reply = remote:InvokeServer(table.unpack(args, 1, args.n)) end
			GameAdapter.auraCompleted += 1
			GameAdapter.lastRequestSeconds = os.clock() - token.started
			if reply == false then
				GameAdapter.auraFalseReplies += 1; GameAdapter.failureStreak += 1
				GameAdapter.retryAt = os.clock() + math.min(8, 0.5 * 2 ^ math.min(GameAdapter.failureStreak - 1, 4))
			else GameAdapter.failureStreak = 0 end
			GameAdapter.lastCombatReply = reply == nil and "nil"
				or ((type(reply) == "boolean" or type(reply) == "number") and tostring(reply) or typeof(reply))
		end)
		GameAdapter.ownCalls[thread] = nil
		if not okay then
			GameAdapter.auraFailed += 1; GameAdapter.failureStreak += 1
			GameAdapter.lastCombatError = tostring(err):sub(1, 120)
			GameAdapter.retryAt = os.clock() + math.min(8, 0.5 * 2 ^ math.min(GameAdapter.failureStreak - 1, 4))
		end
		if GameAdapter.auraPending[humanoid] == token then GameAdapter.auraPending[humanoid] = nil end
		GameAdapter.jobs[token] = nil; GameAdapter.auraInFlight = math.max(0, GameAdapter.auraInFlight - 1)
	end)
