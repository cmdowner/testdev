-- Scale sounds that this client can hear. Game UI sounds live under PlayerGui;
-- world and SoundService sounds use the SFX channel. Restore their original
-- volumes when this UI closes so a later run does not stack multipliers.
local trackedSounds = {}
local soundWatchers = {}
local function soundScale(sound)
	local master = (controls.sliders["Master Volume"] or 80) / 100
	if sound:IsDescendantOf(playerGui) then
		return controls.toggles["UI Sounds"]
			and master * (controls.sliders["UI Volume"] or 70) / 100 or 0
	end
	return master * (controls.sliders["SFX Volume"] or 90) / 100
end
local function applySoundScale(sound, state)
	if not sound.Parent then return end
	local volume = math.clamp(state.original * soundScale(sound), 0, 10)
	state.applied = volume
	sound.Volume = volume
end
local function watchSound(sound)
	if not sound:IsA("Sound") or sound == localSound or trackedSounds[sound] then return end
	local state = {original = sound.Volume}
	trackedSounds[sound] = state
	state.volumeChanged = sound:GetPropertyChangedSignal("Volume"):Connect(function()
		local observed = sound.Volume
		if math.abs(observed - (state.applied or observed)) < 0.0001 then return end
		state.original = observed
		applySoundScale(sound, state)
	end)
	state.ancestryChanged = sound.AncestryChanged:Connect(function()
		applySoundScale(sound, state)
	end)
	state.destroying = sound.Destroying:Connect(function()
		state.volumeChanged:Disconnect()
		state.ancestryChanged:Disconnect()
		trackedSounds[sound] = nil
	end)
	applySoundScale(sound, state)
end
for _, container in ipairs({workspace, SoundService, playerGui}) do
	for _, item in ipairs(container:GetDescendants()) do watchSound(item) end
	table.insert(soundWatchers, container.DescendantAdded:Connect(watchSound))
end
