C.iconCache = {}
C.resolveLucide = function(kind)
	local cached = C.iconCache[kind]
	if cached ~= nil then return cached or nil end
	local bytes = C.lucidePNG[kind]
	local asset = getcustomasset or getsynasset
	if not bytes or type(asset) ~= "function" or type(writefile) ~= "function" then
		C.iconCache[kind] = false; return nil
	end
	local path = "ARG_Core_V7_Lucide_" .. kind .. ".png"
	local okay, result = pcall(function()
		if type(isfile) ~= "function" or not isfile(path) then
			writefile(path, decodeBase64(bytes))
		end
		return asset(path)
	end)
	C.iconCache[kind] = okay and result or false
	return C.iconCache[kind] or nil
end

local animationsEnabled = true

local gui = Instance.new("ScreenGui")
gui.Name = "ARG_Core_V7_Native_UI"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.DisplayOrder = 100
gui.Parent = playerGui

local function make(className, parent, props)
	local object = Instance.new(className)
	for key, value in pairs(props or {}) do
		object[key] = value
	end
	object.Parent = parent
	return object
end

local function frame(parent, x, y, w, h, color, transparency)
	return make("Frame", parent, {
		Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h),
		BackgroundColor3 = color or C.panel, BackgroundTransparency = transparency or 0,
		BorderSizePixel = 0,
	})
end

local function round(object, radius)
	make("UICorner", object, { CornerRadius = UDim.new(0, radius or 6) })
	return object
end

local function stroke(object, color, thickness, transparency)
	make("UIStroke", object, {
		Color = color or C.line, Thickness = thickness or 1,
		Transparency = transparency or 0,
	})
	return object
