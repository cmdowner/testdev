local scanTargets
do
	local function selectCached(cache, rangeOverride)
		local result, stats = {}, table.clone(cache.stats)
		for _, candidate in ipairs(cache.result) do
			local distance = candidate.distance
			local inRange
			if rangeOverride then
				inRange = distance <= rangeOverride and (controls.toggles["Server-Wide Targeting"]
					or distance <= (controls.sliders["Target Scan Range"] or 3000))
			else inRange = GameAdapter.InRange(distance) end
			if inRange then table.insert(result, candidate) end
		end
		if controls.toggles["Priority Targeting"] then
			table.sort(result, function(a, b) return a.distance < b.distance end)
		end
		stats.valid = #result
		return result, stats
	end
	scanTargets = function(force, rangeOverride)
		local clock = os.clock()
		local cache = GameAdapter.scanCache
		if not force and cache and clock - cache.at < 0.1 and cache.revision == controls.scanRevision
			and cache.character == player.Character then return selectCached(cache, rangeOverride) end
		GameAdapter.scanCount = (GameAdapter.scanCount or 0) + 1
		local _, _, root = characterParts()
		local stats = {found = 0, ignored = 0, valid = 0,
			friends = 0, whitelist = 0, protect = 0, checking = 0}
		if not root then return {}, stats end
		local result = {}
		for _, other in ipairs(Players:GetPlayers()) do
			if other ~= player then
				local character = other.Character
				local otherRoot = character and character:FindFirstChild("HumanoidRootPart")
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				if otherRoot and humanoid and humanoid.Health > 0 then
					stats.found += 1
					local allowed, reason = GameAdapter.TargetAllowed(other)
					if not allowed then
						stats.ignored += 1
						if stats[reason] ~= nil then stats[reason] += 1 end
					else table.insert(result, {player = other, distance = (root.Position - otherRoot.Position).Magnitude}) end
				end
			end
		end
		cache = {at = clock, character = player.Character, revision = controls.scanRevision, result = result, stats = stats}
		GameAdapter.scanCache = cache
		GameAdapter.lastScanSeconds = os.clock() - clock
		return selectCached(cache, rangeOverride)
	end
end

-- Local target hitbox adjustment, derived from the public universal pattern
-- but with exact original values restored on disable, target removal, or close.
do
local originalHitboxes = {}
local function restoreHitbox(root)
	local original = originalHitboxes[root]
	if not original then return end
	originalHitboxes[root] = nil
	if root.Parent then
		pcall(function()
			root.Size = original.size
			root.Transparency = original.transparency
			root.CanCollide = original.canCollide
			root.Massless = original.massless
		end)
	end
end
local function restoreHitboxes()
	for root in pairs(originalHitboxes) do restoreHitbox(root) end
end
local function refreshHitboxes()
	local selected = {}
	if controls.toggles["Hitbox Changer"] and inTargetExperience then
		local size = controls.sliders["Hitbox Size"] or 8
		local range = controls.sliders["Hitbox Range"] or 80
		local candidates = scanTargets(false, range)
		for _, candidate in ipairs(candidates) do
			local character = candidate.player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if root and GameAdapter.TargetAllowed(candidate.player) and candidate.distance <= range then
				selected[root] = true
				if not originalHitboxes[root] then
					originalHitboxes[root] = {
						size = root.Size, transparency = root.Transparency,
						canCollide = root.CanCollide, massless = root.Massless,
					}
				end
				pcall(function()
					root.Size = Vector3.new(size, size, size)
					root.Transparency = 1
					root.CanCollide = false
					root.Massless = true
				end)
			end
		end
	end
	for root in pairs(originalHitboxes) do
		if not selected[root] then restoreHitbox(root) end
	end
end
