GameAdapter.ClickTargetReady = function(candidate)
	local state = GameAdapter.click
	local ownCharacter = player.Character
	local ownRoot = ownCharacter and ownCharacter:FindFirstChild("HumanoidRootPart")
	local ownHumanoid = ownCharacter and ownCharacter:FindFirstChildOfClass("Humanoid")
	if not ownRoot or not ownHumanoid or ownHumanoid.Health <= 0 then return false, "Character not ready" end
	if GameAdapter.FightingState() ~= true then return false, "Enter the fight area (Fighting must be true)" end
	local other = candidate and candidate.player
	local character = other and other.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not other or other.Parent ~= Players or not root or not humanoid or humanoid.Health <= 0 then
		return false, "No live nearby target"
	end
	local allowed, reason = GameAdapter.TargetAllowed(other)
	if not allowed then return false, "Target blocked: " .. tostring(reason) end
	if (ownRoot.Position - root.Position).Magnitude > GameAdapter.ClickRange() then
		return false, "Target outside click activation radius"
	end
	-- A normal click does not address a particular player. Fail closed if any
	-- excluded/unknown player is nearby; do not promise a friend-proof server hit.
	local safetyRange = math.max(24, GameAdapter.ClickRange())
	for _, nearby in ipairs(Players:GetPlayers()) do
		local rig = nearby.Character
		local nearbyRoot = rig and rig:FindFirstChild("HumanoidRootPart")
		local nearbyHumanoid = rig and rig:FindFirstChildOfClass("Humanoid")
		if nearby ~= player and nearbyRoot and nearbyHumanoid and nearbyHumanoid.Health > 0
			and (ownRoot.Position - nearbyRoot.Position).Magnitude <= safetyRange then
