do
	local attackedOnce, scanning = false, false
	local lastTarget, lastTargetCharacter, ownCharacter
	local lastAttempt, epoch = -math.huge, -1
	local auraHeartbeat = RunService.Heartbeat:Connect(function()
		if not gui.Parent or not inTargetExperience or not controls.toggles["Omega Aura"] then
			attackedOnce, lastTarget, lastTargetCharacter = false, nil, nil
			lastAttempt = -math.huge
			return
		end
		if not player.Character then return end
		if ownCharacter ~= player.Character then
			local respawned = ownCharacter ~= nil
			ownCharacter = player.Character; GameAdapter.auraEpoch += 1
			if respawned and not controls.toggles["Repeat After Respawn"] then setToggle("Omega Aura", false); return end
		end
		if epoch ~= GameAdapter.auraEpoch then
			epoch = GameAdapter.auraEpoch
			attackedOnce, lastTarget, lastTargetCharacter = false, nil, nil
			lastAttempt = -math.huge
		end
		local clock = os.clock()
		if scanning or clock - lastAttempt < GameAdapter.Interval() then return end
		-- Throttle attempts even with no targets, pending requests, or a rejection.
		lastAttempt = clock
		if GameAdapter.FightingState() == false or clock < GameAdapter.retryAt
			or clock < GameAdapter.nextDispatch or GameAdapter.OldestRequest() >= GameAdapter.requestTimeout then return end
		scanning = true
		local requestEpoch = epoch
		local okay, err = pcall(function()
			local candidates = scanTargets()
			if controls.toggles["Screen Click Combat"] and #candidates == 0 then
				GameAdapter.click.pauseReason = "No eligible nearby target"
			end
			if not gui.Parent or not controls.toggles["Omega Aura"] or requestEpoch ~= GameAdapter.auraEpoch then return end
			local lastTargetStillValid = false
			for _, candidate in ipairs(candidates) do
				if candidate.player == lastTarget and candidate.player.Character == lastTargetCharacter then lastTargetStillValid = true; break end
			end
			if controls.toggles["Continuous Attack"] or not attackedOnce
				or (controls.toggles["Auto Re-Target"] and not lastTargetStillValid) then
				local limit = controls.toggles["Multi-Target Mode"] and (controls.sliders["Max Targets"] or 1) or 1
				if #candidates > 0 then
					local sent, target, character = GameAdapter.Attack(candidates, limit)
					if sent then attackedOnce, lastTarget, lastTargetCharacter = true, target, character end
				end
			end
		end)
		scanning = false
		if not okay then GameAdapter.lastCombatError = tostring(err):sub(1, 120) end
	end)
	gui.Destroying:Connect(function() GameAdapter.auraEpoch += 1; auraHeartbeat:Disconnect() end)
