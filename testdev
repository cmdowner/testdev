-- Public aura v5/v7 use motor recovery and these two ragdoll events. Keep
-- changes scoped to this character and reversible; never destroy rig parts.
do
	local P = {modified = {}, disabledConnections = {}, previousStates = {},
		lastScan = -math.huge, lastEvents = -math.huge,
		carryLinks = 0, recoveredMotors = 0, ragdollConstraints = 0, eventsDisabled = 0}
	controls.protectionRuntime = P
	local states = {Enum.HumanoidStateType.Ragdoll, Enum.HumanoidStateType.Physics,
		Enum.HumanoidStateType.FallingDown, Enum.HumanoidStateType.PlatformStanding}
	local carryNames = {"Anti-Grab", "Anti-Carry Lock", "Break Carry", "Break Hold",
		"Stop Ceiling Hold", "Stop Wall Pin", "Anti-Repeat Carry"}
	local function carryEnabled()
		for _, name in ipairs(carryNames) do if controls.toggles[name] then return true end end
		return false
	end
	local function ownBody(part, character)
		return part and part:IsA("BasePart") and part:IsDescendantOf(character)
			and not part:FindFirstAncestorOfClass("Tool")
			and not part:FindFirstAncestorOfClass("Accessory")
	end
	local function setEnabled(object, value, kind)
		local okay, before = pcall(function() return object.Enabled end)
		if not okay or type(before) ~= "boolean" or before == value then return false end
		local changed = pcall(function() object.Enabled = value end)
		if not changed then return false end
		P.modified[object] = P.modified[object] or {before = before, kind = kind}
		P.modified[object].written = value
		return true
	end
	local function restoreModified(kind)
		for object, entry in pairs(P.modified) do
			if kind == nil or entry.kind == kind then
				pcall(function()
					if object.Parent and object.Enabled == entry.written then object.Enabled = entry.before end
				end)
				P.modified[object] = nil
			end
		end
	end
	local function restoreConnections()
		for connection in pairs(P.disabledConnections) do
			pcall(function()
				if connection.Enabled == false and connection.Connected ~= false then connection:Enable() end
			end)
		end
		table.clear(P.disabledConnections)
	end
	P.Restore = function()
		restoreModified()
		restoreConnections()
		if P.humanoid and P.humanoid.Parent then
			for state, enabled in pairs(P.previousStates) do
				pcall(function() P.humanoid:SetStateEnabled(state, enabled) end)
			end
			if P.originalAutoRotate ~= nil then
				pcall(function() P.humanoid.AutoRotate = P.originalAutoRotate end)
			end
		end
		table.clear(P.previousStates)
		P.character, P.humanoid, P.originalAutoRotate = nil, nil, nil
		P.carryLinks, P.recoveredMotors, P.ragdollConstraints, P.eventsDisabled = 0, 0, 0, 0
		P.lastScan, P.lastEvents = -math.huge, -math.huge
	end
	local function suppressEvent(signal)
		if type(getconnections) ~= "function" then return end
		local okay, connections = pcall(getconnections, signal)
		if not okay or type(connections) ~= "table" then return end
		for _, connection in ipairs(connections) do
			-- Do not turn on listeners which were already disabled by the game
			-- or another script. Executors without Enabled leave them untouched.
			local read, enabled, connected = pcall(function() return connection.Enabled, connection.Connected end)
			if read and enabled == true and connected ~= false then
				local disabled = pcall(function() connection:Disable() end)
				if disabled then P.disabledConnections[connection] = true end
			end
		end
	end
	local function updateEvents()
		if os.clock() - P.lastEvents < 0.5 then return end
		P.lastEvents = os.clock()
		local storage = game:GetService("ReplicatedStorage")
		local events = storage:FindFirstChild("Events")
		local remote = events and events:FindFirstChild("RagdollState")
		local localEvent = storage:FindFirstChild("LocalRagdollEvent")
		if remote and remote:IsA("RemoteEvent") then suppressEvent(remote.OnClientEvent) end
		if localEvent and localEvent:IsA("BindableEvent") then suppressEvent(localEvent.Event) end
		local count = 0
		for connection in pairs(P.disabledConnections) do
			local okay, connected = pcall(function() return connection.Connected end)
			if okay and connected ~= false then count += 1 else P.disabledConnections[connection] = nil end
		end
		P.eventsDisabled = count
	end
	local function endpoints(object)
		local okay, a, b = pcall(function() return object.Part0, object.Part1 end)
		if okay and (a or b) then return a, b end
		okay, a, b = pcall(function() return object.Attachment0, object.Attachment1 end)
		if okay then return a and a.Parent, b and b.Parent end
	end
	local function named(object, pattern, character)
		local current = object
		while current and current ~= character and current ~= workspace do
			if current.Name:lower():find(pattern, 1, true) then return true end
			current = current.Parent
		end
		return false
	end
	local function carryLink(object, character)
		if object.Name == "SeatWeld" or object:IsA("NoCollisionConstraint") then return false end
		if not (object:IsA("JointInstance") or object:IsA("WeldConstraint") or object:IsA("Constraint")) then
			return false
		end
		local a, b = endpoints(object)
		local ownA, ownB = ownBody(a, character), ownBody(b, character)
		local explicitHold = named(object, "carry", character) or named(object, "grab", character)
			or named(object, "hold", character) or named(object, "wallpin", character)
			or named(object, "wall_pin", character)
		if not a or not b then
			return (ownA or ownB) and explicitHold
				and (object:IsA("AlignPosition") or object:IsA("AlignOrientation"))
		end
		if ownA == ownB then return false end
		local outside = ownA and b or a
		if outside:IsDescendantOf(character) then return false end
		for _, other in ipairs(Players:GetPlayers()) do
			if other ~= player and other.Character and outside:IsDescendantOf(other.Character) then return true end
		end
		return explicitHold
	end
	local function scanRig(character, humanoid, carry)
		for object in pairs(P.modified) do if not object.Parent then P.modified[object] = nil end end
		local objects, seen, motors = {}, {}, {}
		local disabledMotors = 0
		local function add(object)
			if object and not seen[object] then seen[object] = true; table.insert(objects, object) end
		end
		for _, object in ipairs(controls.CharacterItems(character).all) do
			add(object)
			if object:IsA("BasePart") then
				-- A carry weld may be parented to the carrier, outside our rig.
				local okay, joints = pcall(function() return object:GetJoints() end)
				if okay and type(joints) == "table" then for _, joint in ipairs(joints) do add(joint) end end
			elseif object:IsA("Attachment") then
				local okay, constraints = pcall(function() return object:GetConstraints() end)
				if okay and type(constraints) == "table" then
					for _, constraint in ipairs(constraints) do add(constraint) end
				end
			end
		end
		for _, object in ipairs(objects) do
			if object:IsA("Motor6D") then
				local a, b = endpoints(object)
				if ownBody(a, character) and ownBody(b, character) then
					table.insert(motors, object)
					if object.Enabled == false then disabledMotors += 1 end
				end
			end
		end
		local state = humanoid:GetState()
		local ragdoll = humanoid.PlatformStand and not controls.toggles.Fly
			or state == Enum.HumanoidStateType.Ragdoll or state == Enum.HumanoidStateType.FallingDown
			or (state == Enum.HumanoidStateType.Physics and not controls.toggles.Fly)
			or (#motors > 0 and disabledMotors / #motors >= 0.9)
		local carryCount, constraintCount, motorCount = 0, 0, 0
		for _, object in ipairs(objects) do
			if carry and carryLink(object, character) then
				if setEnabled(object, false, "carry") then carryCount += 1 end
			elseif object:IsA("Constraint") and not object:IsA("NoCollisionConstraint") then
				local a, b = endpoints(object)
				if ownBody(a, character) and ownBody(b, character)
					and (named(object, "ragdoll", character) or (ragdoll
						and (object:IsA("BallSocketConstraint") or object:IsA("HingeConstraint")))) then
					if setEnabled(object, false, "ragdoll") then constraintCount += 1 end
				end
			end
		end
		if ragdoll then
			for _, motor in ipairs(motors) do
				if setEnabled(motor, true, "motor") then motorCount += 1 end
			end
		end
		P.carryLinks += carryCount; P.recoveredMotors += motorCount; P.ragdollConstraints += constraintCount
		P.ragdollDetected = ragdoll
		if carryCount + constraintCount + motorCount > 0 then
			P.lastEvent = string.format("Recovered %d carry links / %d motors / %d ragdoll constraints",
				carryCount, motorCount, constraintCount)
			if P.OnEvent then P.OnEvent(P.lastEvent) end
		end
	end
	P.Update = function(character, humanoid, root)
		local carry = carryEnabled()
		local active = inTargetExperience and (carry or controls.toggles["Anti Ragdoll"])
		if not active or not character or not humanoid or not root or humanoid.Health <= 0 then
			if P.character then P.Restore() end
			return
		end
		if P.character ~= character or P.humanoid ~= humanoid then
			P.Restore()
			P.character, P.humanoid = character, humanoid
			P.originalAutoRotate = humanoid.AutoRotate
			for _, state in ipairs(states) do
				local okay, enabled = pcall(function() return humanoid:GetStateEnabled(state) end)
				if okay then P.previousStates[state] = enabled end
			end
		end
		if not carry then restoreModified("carry") end
		updateEvents()
		if os.clock() - P.lastScan >= 0.1 then
			P.lastScan = os.clock()
			scanRig(character, humanoid, carry)
		end
		for state, enabled in pairs(P.previousStates) do
			local flyingState = controls.toggles.Fly and (state == Enum.HumanoidStateType.Physics
				or state == Enum.HumanoidStateType.PlatformStanding)
			pcall(function()
				local wanted = false
				if flyingState then wanted = enabled end
				if humanoid:GetStateEnabled(state) ~= wanted then humanoid:SetStateEnabled(state, wanted) end
			end)
		end
		if not controls.toggles.Fly then
			local state = humanoid:GetState()
			if humanoid.PlatformStand or P.ragdollDetected or state == Enum.HumanoidStateType.Physics
				or state == Enum.HumanoidStateType.Ragdoll or state == Enum.HumanoidStateType.FallingDown then
				humanoid.PlatformStand = false
				humanoid.AutoRotate = true
				humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
				P.ragdollDetected = false
			end
		end
	end
	hooks.toggles["Anti Ragdoll"] = function()
		local okay, err = pcall(P.Update, characterParts())
		if not okay then P.lastError = tostring(err):sub(1, 160) end
	end
	gui.Destroying:Connect(P.Restore)
end
