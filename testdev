local memoryConfigs = {}
local function configSlot()
	return tostring(math.floor(controls.sliders["Config Slot"] or 1))
end
local function configName()
	return "ARG_Core_V7_Config_" .. configSlot() .. ".json"
end
actionHandlers["Save Config"] = function()
	local data = {toggles = controls.toggles, sliders = controls.sliders, lists = listEntries}
	local encoded = HttpService:JSONEncode(data)
	memoryConfigs[configSlot()] = encoded
	if type(writefile) == "function" then
		local okay = pcall(writefile, configName(), encoded)
		notify(okay and "Saved config slot " .. configSlot() or "Saved config in this session")
	else
		notify("Saved config slot " .. configSlot() .. " for this session")
	end
end
actionHandlers["Load Config"] = function()
	local encoded = memoryConfigs[configSlot()]
	if type(readfile) == "function" then
		local okay, result = pcall(readfile, configName())
		if okay and type(result) == "string" then encoded = result end
	end
	if not encoded then notify("No config in slot " .. configSlot()) return end
	local data = HttpService:JSONDecode(encoded)
	for name, value in pairs(data.sliders or {}) do
		if sliderDefaults[name] ~= nil and type(value) == "number" then setSlider(name, value) end
	end
	for name, value in pairs(data.toggles or {}) do
		if controls.toggleViews[name] and type(value) == "boolean" then setToggle(name, value) end
	end
	for name, values in pairs(data.lists or {}) do
		if listEntries[name] and type(values) == "table" then
			table.clear(listEntries[name])
			for _, value in ipairs(values) do table.insert(listEntries[name], tostring(value)) end
			for _, view in ipairs(listCountViews[name] or {}) do
				view.Text = tostring(#listEntries[name]) .. " SAVED"
			end
		end
	end
	notify("Loaded config slot " .. configSlot())
end
actionHandlers["Clear / Reset"] = function()
	for name in pairs(controls.toggleViews) do setToggle(name, false) end
	for name, value in pairs(sliderDefaults) do setSlider(name, value) end
	for name, entries in pairs(listEntries) do
		table.clear(entries)
		for _, view in ipairs(listCountViews[name] or {}) do view.Text = "0 SAVED" end
	end
	localSound:Stop()
	notify("UI and local settings reset")
end
