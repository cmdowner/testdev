GameAdapter.Remote = function(names)
	if not inTargetExperience then return nil end
	local key, clock = table.concat(names, "/"), os.clock()
	local entry = GameAdapter.remoteCache[key]
	if entry and entry.remote and entry.remote.Parent then return entry.remote end
	if entry and clock - entry.checked < 3 then return nil end
	local storage = game:GetService("ReplicatedStorage")
	-- All feature lookups share one traversal; prioritize the published Remotes folder.
	local folder = storage:FindFirstChild("Remotes")
	for _, name in ipairs(names) do
		local remote = folder and folder:FindFirstChild(name)
		if remote and (remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction")) then
			GameAdapter.remoteCache[key] = {remote = remote, checked = clock}; return remote
